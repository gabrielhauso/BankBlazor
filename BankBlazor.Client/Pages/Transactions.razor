@page "/transactions"
@inject HttpClient Http

<div class="container">
    <label>Account ID:</label>
    <input type="number" @bind="accountId" placeholder="Enter Account ID" />
    <button @onclick="GetTransactions">Search</button>
</div>

@if (transactions != null)
{
    <div class="container">
        <h3>Transactions for Account @accountId</h3>
        <table>
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Operation</th>
                    <th>Amount</th>
                    <th>Balance</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in transactions)
                {
                    <tr>
                        <td>@t.Date</td>
                        <td>@t.Type</td>
                        <td>@t.Operation</td>
                        <td>@t.Amount</td>
                        <td>@t.Balance</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="container transaction-actions">
    <h3>Actions</h3>
    <div class="action-group">
        <label>Amount:</label>
        <input type="number" @bind="amount" placeholder="Enter amount" />
        <button @onclick="Deposit">Deposit</button>
        <button @onclick="Withdraw">Withdraw</button>
    </div>
    
    <h4>Transfer to another account</h4>
    <div class="action-group">
        <label>To Account ID:</label>
        <input type="number" @bind="toAccountId" placeholder="Enter Account ID" />
        <label>Amount:</label>
        <input type="number" @bind="amount" placeholder="Enter amount" />
        <button @onclick="Transfer">Transfer</button>
    </div>
</div>



@code {
    private int accountId;
    private List<TransactionViewModel>? transactions;
    private decimal amount;
    private int toAccountId;

    private async Task GetTransactions()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<List<TransactionViewModel>>($"api/Account/{accountId}/transactions");

            transactions = result.Select(t => new TransactionViewModel
            {
                TransactionId = t.TransactionId,
                AccountId = t.AccountId,
                Date = t.Date,
                Type = t.Type,
                Operation = t.Operation,
                Amount = t.Amount,
                Balance = t.Balance
            }).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    private async Task Deposit()
    {
        try
        {
            var result = await Http.PostAsJsonAsync($"api/Account/deposit?accountId={accountId}&amount={amount}", new{});

            if (result.IsSuccessStatusCode)
            {
                await GetTransactions();
            }

        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    private async Task Withdraw()
    {
        try
        {
            var result = await Http.PostAsJsonAsync($"api/Account/Withdraw?accountId={accountId}&amount={amount}", new { });

            if (result.IsSuccessStatusCode)
            {
                await GetTransactions();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }

    }

    private async Task Transfer()
    {
        try
        {
            var result = await Http.PostAsJsonAsync($"api/Account/Transfer?fromAccountId={accountId}&toAccountId={toAccountId}&amount={amount}", new { });

            if (result.IsSuccessStatusCode)
            {
                await GetTransactions();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
            
        

    }
}