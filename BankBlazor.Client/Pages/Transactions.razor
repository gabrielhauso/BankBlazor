@page "/transactions"
@inject HttpClient Http

<div>
    <label>Account ID:</label>
    <input type="number" @bind="accountId" placeholder="Enter Account ID" />
    <button @onclick="GetTransactions">Search</button>
</div>

@if (transactions != null)
{
    <h3>Transactions for Account @accountId</h3>
    <table>
        <thead>
            <tr>
                <th>Date</th>
                <th>Type</th>
                <th>Operation</th>
                <th>Amount</th>
                <th>Balance</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in transactions)
            {
                <tr>
                    <td>@t.Date</td>
                    <td>@t.Type</td>
                    <td>@t.Operation</td>
                    <td>@t.Amount</td>
                    <td>@t.Balance</td>
                </tr>
            }
        </tbody>
    </table>
}



@code {
    private int accountId;
    private List<TransactionViewModel>? transactions;

    private async Task GetTransactions()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<List<TransactionViewModel>>($"api/Account/{accountId}/transactions");

            transactions = result.Select(t => new TransactionViewModel
            {
                TransactionId = t.TransactionId,
                AccountId = t.AccountId,
                Date = t.Date,
                Type = t.Type,
                Operation = t.Operation,
                Amount = t.Amount,
                Balance = t.Balance
            }).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }
}