@page "/dashboard"
@inject HttpClient Http

<div class="container">
    <label>Customer ID:</label>
    <input type="number" @bind="customerId" placeholder="Enter Customer ID" />
    <button @onclick="GetCustomer">Search</button>
</div>

@if (customerViewModel != null)
{
    <div class="container">
        <h3>Customer Dashboard</h3>
        <p><strong>Name:</strong> @customerViewModel.Givenname @customerViewModel.Surname</p>
        <p><strong>Email:</strong> @customerViewModel.Emailaddress</p>
        <p><strong>Phone:</strong> @customerViewModel.Telephonenumber</p>
        <p><strong>Address:</strong> @customerViewModel.Streetaddress, @customerViewModel.City, @customerViewModel.Country</p>
        <p><strong>Birthday:</strong> @customerViewModel.Birthday</p>
    </div>

    <div class="container">
        <h3>Accounts</h3>
        @foreach (var account in customerViewModel.Accounts)
        {
            <div class="account-card">
                <p><strong>Account ID:</strong> @account.AccountId</p>
                <p><strong>Balance:</strong> @account.Balance</p>
                <p><strong>Frequency:</strong> @account.Frequency</p>
                <p><strong>Created:</strong> @account.Created</p>
            </div>
        }
    </div>
}


@code {
    private int customerId;
    private CustomerViewModel? customerViewModel;


    private async Task GetCustomer()
    {
        try
        {
            var customer = await Http.GetFromJsonAsync<CustomerViewModel>($"api/Customer/{customerId}");

            if (customer == null)
            {
                return;
            }

            customerViewModel = new CustomerViewModel
            {
                CustomerId = customer.CustomerId,
                Gender = customer.Gender,
                Givenname = customer.Givenname,
                Surname = customer.Surname,
                Emailaddress = customer.Emailaddress,
                City = customer.City,
                Zipcode = customer.Zipcode,
                Country = customer.Country,
                Streetaddress = customer.Streetaddress,
                Telephonenumber = customer.Telephonenumber,
                Birthday = customer.Birthday,
                Accounts = customer.Accounts
            };
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }
}